OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Local dev Postgres — matches docker-compose.yml's db service.
# traceview_readonly is the actual safety boundary for query execution
# (SELECT-only, enforced by Postgres — see schema.sql), not a real secret.
DATABASE_URL=postgresql://traceview:traceview_dev_only@localhost:5432/traceview
DATABASE_URL_READONLY=postgresql://traceview_readonly:traceview_readonly_dev_only@localhost:5432/traceview
