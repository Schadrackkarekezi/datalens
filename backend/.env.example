OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Local dev Postgres — matches docker-compose.yml's db service.
# datalens_readonly is the actual safety boundary for query execution
# (SELECT-only, enforced by Postgres — see schema.sql), not a real secret.
DATABASE_URL=postgresql://datalens:datalens_dev_only@localhost:5432/datalens
DATABASE_URL_READONLY=postgresql://datalens_readonly:datalens_readonly_dev_only@localhost:5432/datalens
